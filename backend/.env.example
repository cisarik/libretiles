# =============================================================================
# Libre Tiles — Backend Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Django
# DJANGO_SECRET_KEY is required. No default is shipped. Leave this line empty
# in the example. ./scripts/libretiles.sh generates a strong value into a
# freshly created backend/.env and never overwrites an existing file. A
# pre-existing .env overrides new code defaults and is read once at process
# start — review it after any settings change.
# Use at least 50 characters with 5 unique characters. Do not reuse the
# public insecure fallback literal from older templates. Do not use the
# django-insecure- prefix.
DJANGO_SECRET_KEY=
# Production Docker uses DJANGO_SECRET_KEY_FILE instead. Set exactly one source;
# the file path must be absolute and its value is never logged.
# DJANGO_SECRET_KEY_FILE=/run/secrets/django_secret_key
# Local development: true (plain HTTP). Production: false.
DJANGO_DEBUG='true'
# Local development may use localhost. Production must be an explicit
# hostname list without wildcards.
DJANGO_ALLOWED_HOSTS='localhost,127.0.0.1'

# Shared throttle/lockout cache when DJANGO_DEBUG is false.
# Unused for local `DJANGO_DEBUG=true` boot. LocMemCache serves the debug
# cache. Required in production: a redis:// or rediss:// URL. If unset,
# REDIS_URL is the fallback; if both are empty, Django refuses to start.
# DJANGO_THROTTLE_CACHE_URL=

# Trusted reverse-proxy count for DRF unauthenticated throttle identity.
# 0 (default) keys buckets on REMOTE_ADDR, matching django-axes (ipware is
# not installed). Set to the real number of trusted proxies in front of
# Django. Invalid values refuse to start.
# DJANGO_NUM_PROXIES=0
# DJANGO_SECURE_PROXY_SSL_HEADER='false'  # true only behind a stripping TLS proxy

# Database
# SQLite for dev (zero config), PostgreSQL for production
DB_ENGINE='sqlite3'
# DB_ENGINE='postgresql'
# PostgreSQL mode requires explicit DB_NAME, DB_USER, DB_PASSWORD (or
# DB_PASSWORD_FILE), and DB_HOST. There are no production credential defaults.
# DB_NAME='libretiles'
# DB_USER='libretiles'
# DB_PASSWORD=
# DB_PASSWORD_FILE=/run/secrets/postgres_password
# DB_HOST='localhost'
# DB_PORT='5432'
# PostgreSQL connection persistence (ignored on SQLite). CONN_MAX_AGE is the
# maximum lifetime in seconds of a reused database connection (0 disables
# persistence; unset keeps the default 600). CONN_HEALTH_CHECKS makes Django
# verify a reused connection is still alive before handing it out (default
# true). Invalid or negative CONN_MAX_AGE values refuse to start.
# DB_CONN_MAX_AGE='600'
# DB_CONN_HEALTH_CHECKS='true'

# CORS — frontend origins allowed to call this API
CORS_ALLOWED_ORIGINS='http://localhost:3000'
# DJANGO_CSRF_TRUSTED_ORIGINS=   # optional override; default = CORS_ALLOWED_ORIGINS

# Realtime / Channels
REDIS_URL='redis://127.0.0.1:6379/0'
GAME_WS_TICKET_MAX_AGE_SECONDS='10'

# AI credentials live on the Next.js frontend (OPENROUTER_API_KEY and NVIDIA_API_KEY).
# Do not put those keys here.
# AI budget defaults (passed to game context for move/judge routes)
AI_MOVE_MAX_OUTPUT_TOKENS='15000'
AI_MOVE_TIMEOUT_SECONDS='120'

# When false, /api/catalog/models/ returns the curated bootstrap pairs only.
# When true, returns the four newest eligible OpenRouter models plus seeded NIM.
# Spelling must match backend/config/settings.py exactly.
DYNAMIC_FREE_MODEL_CATALOG_ENABLED='false'

# Admin live catalog probes are disabled unless this is exactly 1. Leave unset
# for fake/simulated probes (zero provider calls). Never put provider secrets
# in this file; live probes read frontend/server credential names only.
# PROVIDER_PROBE_LIVE=

# When false, manage.py purge_legacy_game_state is fail-closed: it will not
# delete rows unless the five development game-state tables are already empty.
# When true, it empties those five tables only (one-time development purge).
# Spelling must match backend/config/settings.py exactly.
# A pre-existing .env overrides code defaults and is read once at process start.
ALLOW_DESTRUCTIVE_GAME_STATE_RESET='false'

# Game assets
# PRIMARY_DICTIONARY_FILE repoints the ENGLISH Tier-1 dictionary at a different
# basename under backend/assets/dicts/. Default: collins2019.txt (279,496 words).
# Normally leave this unset.
# A value here BYPASSES the variant manifest and the lexicon-provenance
# machinery: backend/assets/variants/english.json still declares
# dictionary_file collins2019.txt, and manage.py validate_lexicons still audits
# the manifest's file, so an override is invisible to both.
# Consumed by backend/config/settings.py as PRIMARY_DICTIONARY_PATH.
# A pre-existing .env overrides code defaults and is read once at process start.
# PRIMARY_DICTIONARY_FILE='collins2019.txt'

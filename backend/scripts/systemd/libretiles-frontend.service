[Unit]
Description=Libre Tiles Next.js frontend
Wants=network-online.target
After=network-online.target libretiles-backend.service
Requires=libretiles-backend.service

[Service]
Type=simple
User=libretiles
Group=libretiles
WorkingDirectory=PROJECT_ROOT/frontend
EnvironmentFile=PROJECT_ROOT/frontend/.env.local
Environment=NODE_ENV=production
ExecStart=/usr/bin/node PROJECT_ROOT/frontend/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target

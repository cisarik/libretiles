# Non-secret production selectors. Copy to .env.docker and replace every
# example.invalid / replace-me value. Secret values live in deploy/secrets/.
DOMAIN=example.invalid
ACME_EMAIL=admin@example.invalid
APP_VERSION=replace-me-with-git-sha
IMAGE_PREFIX=libretiles-
POSTGRES_DB=libretiles
POSTGRES_USER=libretiles
POSTGRES_DATA_VOLUME=libretiles-postgres-data
POSTGRES_BACKUP_VOLUME=libretiles-postgres-backups
CERTBOT_CONFIG_VOLUME=libretiles-certbot-config
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
ADMIN_PORT=8443
# Each referenced file must be a regular file with host metadata 0:10004/0440
# inside root-owned mode-0700 deploy/secrets/. See deploy/secrets/README.md.
DJANGO_SECRET_KEY_FILE=./deploy/secrets/django-secret-key
POSTGRES_PASSWORD_FILE=./deploy/secrets/postgres-password
FRONTEND_CREDENTIALS_FILE=./deploy/secrets/frontend-credentials.json

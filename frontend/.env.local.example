# =============================================================================
# Libre Tiles — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Django backend URL used by browser-side API calls.
# `localhost` works for desktop dev and is auto-rewritten to the current LAN
# hostname when the frontend is opened from another device.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Django backend URL used by Next.js server-side route handlers.
BACKEND_URL=http://localhost:8000

# Optional: additional dev hosts/origins allowed to load Next.js dev assets.
# Example: NEXT_DEV_ALLOWED_ORIGINS=tablet.local,192.168.1.164
# NEXT_DEV_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Direct free rivals (server-only; rows stay inactive until capability PASS)
# Provider base URLs and exact model IDs are hardcoded in the server runtime.
# Do not add NEXT_PUBLIC_ or provider base-URL variables for these credentials.
# ---------------------------------------------------------------------------

# Groq — https://api.groq.com/openai/v1
GROQ_API_KEY=your-groq-api-key

# Google Gemini OpenAI compatibility —
# https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=your-gemini-api-key

# Cloudflare Workers AI — account id must be exactly 32 hexadecimal characters.
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Mistral — https://api.mistral.ai/v1
MISTRAL_API_KEY=your-mistral-api-key

# ---------------------------------------------------------------------------
# Prepared watchlist runtimes (keep catalog rows inactive until probe PASS)
# ---------------------------------------------------------------------------
AION_API_KEY=your-aion-api-key
HF_TOKEN=your-huggingface-token

# ---------------------------------------------------------------------------
# IBM watsonx.ai IAM runtime. No implicit runtime region default; configure one
# of: eu-de, eu-gb, us-south, jp-tok, au-syd.
# ---------------------------------------------------------------------------
# IBM_CLOUD_API_KEY=your-ibm-cloud-api-key
# IBM_WATSONX_PROJECT_ID=your-ibm-watsonx-project-id
# IBM_WATSONX_REGION=eu-de

# ---------------------------------------------------------------------------
# OpenRouter compatibility tail (the UI still boots without a key)
# Get a key at https://openrouter.ai/keys
# Server-only. The API base URL is hardcoded to https://openrouter.ai/api/v1
# in frontend/src/lib/openrouter.ts; do not add a base-URL env var.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key

# ---------------------------------------------------------------------------
# NVIDIA NIM compatibility tail
# Get a key at https://build.nvidia.com
# Server-only. The API base URL is hardcoded to
# https://integrate.api.nvidia.com/v1 in frontend/src/lib/nvidia-nim.ts;
# do not add a base-URL env var. The UI still boots if either key is missing.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key

# ---------------------------------------------------------------------------
# Manual capability probe selectors (server-only, never NEXT_PUBLIC_).
# Prefer passing these inline to `npm run probe:provider` as documented in the
# repository README. The command is explicit and consumes provider quota; it
# never runs during boot, catalog sync, gameplay, build, or ordinary tests.
# ---------------------------------------------------------------------------
# PROVIDER_PROBE_PROVIDER=groq
# PROVIDER_PROBE_MODEL=openai/gpt-oss-120b

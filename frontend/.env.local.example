# =============================================================================
# Libre Tiles — Frontend Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.

# Django backend URL used by browser-side API calls.
# `localhost` works for desktop dev and is auto-rewritten to the current LAN
# hostname when the frontend is opened from another device.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Django backend URL used by Next.js server-side route handlers.
BACKEND_URL=http://localhost:8000

# Optional: additional dev hosts/origins allowed to load Next.js dev assets.
# Example: NEXT_DEV_ALLOWED_ORIGINS=tablet.local,192.168.1.164
# NEXT_DEV_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# OpenRouter (required for AI turns; the UI still boots without a key)
# Get a key at https://openrouter.ai/keys
# Server-only. The API base URL is hardcoded to https://openrouter.ai/api/v1
# in frontend/src/lib/openrouter.ts; do not add a base-URL env var.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=your-openrouter-api-key

# ---------------------------------------------------------------------------
# NVIDIA NIM (optional second runtime for the Nemotron rival)
# Get a key at https://build.nvidia.com
# Server-only. The API base URL is hardcoded to
# https://integrate.api.nvidia.com/v1 in frontend/src/lib/nvidia-nim.ts;
# do not add a base-URL env var. The UI still boots if either key is missing.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=your-nvidia-api-key
